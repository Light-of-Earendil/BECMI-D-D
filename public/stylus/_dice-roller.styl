      .face
        position: absolute
        left: 50%
        top: 0
        margin: 0 -50px
        border-left: 50px solid transparent
        border-right: 50px solid transparent
        width: 0px
        height: 0px
        transform-style: preserve-3d
        backface-visibility: hidden

        &:not(.show)
          filter: brightness(0.8)

        &.dark
          filter: brightness(0.5)

        &:before
          content: attr(data-before)
          position: absolute
          top: 21.5px
          left: -100px
          color: #fff
          text-shadow: 2px 2px 1px #ffffff80, 2px -2px 1px #000000e0, -2px 2px 1px #000000e0, -2px -2px 1px #000000e0
          font-size: 2.6875rem
          text-align: center
          line-height: 77.4px
          width: 200px
          height: 86px

        &.animate:before
          transition: 1s all

        &.big,
        &.big:before
          font-size: 6.25rem
          position: absolute
          z-index: 1000
          filter: drop-shadow(2px 4px 6px black)

      &.wood
        d20SpecialSkin('wood', 3)

