d4SpecialSkin($file, $fontoption)
  .face
    if $fontoption is 0
      d4Clear()
    if $fontoption is 1
      d4DiceFontArialClear()
    if $fontoption is 2
      d4DiceFontCaveat()
    if $fontoption is 3
      d4DiceFontLavish()

    &:after
      if $fontoption is 0
        d4Clear()
      if $fontoption is 1
        d4DiceFontArialClear()
      if $fontoption is 2
        d4DiceFontCaveat()
      if $fontoption is 3
        d4DiceFontLavish()
      line-height: 77px
      left: -55px
      top: 40px

    &:before
      if $fontoption is 0
        d4Clear()
      if $fontoption is 1
        d4DiceFontArialClear()
      if $fontoption is 2
        d4DiceFontCaveat()
      if $fontoption is 3
        d4DiceFontLavish()
      line-height: 80px
      top: 52px
      left: -56px

  for num in (1..4)
    .face.face-{num}
      diceface(num, $file + '/D6-')

d6SpecialSkin($file, $fontoption)
  .face:before
    if $fontoption is 0
      d6Clear()
    if $fontoption is 1
      d6DiceFontArialClear()
    if $fontoption is 2
      d6DiceFontCaveat()
    if $fontoption is 3
      d6DiceFontLavish()

  for num in (1..6)
    .face.face-{num}
      diceface(num, $file + '/D6-')

      &:after
        diceface(num, $file + '/D6-')

