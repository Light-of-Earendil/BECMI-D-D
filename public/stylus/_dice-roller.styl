#becmi-dice-overlay
  position: fixed
  inset: 0
  display: flex
  align-items: center
  justify-content: center
  z-index: 11000
  opacity: 0
  pointer-events: none
  transition: opacity 400ms ease

  &.is-visible
    opacity: 1
    pointer-events: auto

  .becmi-dice-overlay__scrim
    position: absolute
    inset: 0
    background: rgba(7, 3, 2, 0.72)
    backdrop-filter: blur(4px)

  .becmi-dice-stage
    position: relative
    width: 760px
    max-width: 92vw
    height: 460px
    max-height: 78vh
    display: flex
    align-items: center
    justify-content: center

  #dices.diecontainer.box,
  .multiple-dice-container.box
    position: relative
    width: 600px
    max-width: 92vw
    height: 350px
    z-index: 106
    box-shadow: 5px 5px 40px #000
    background: linear-gradient(180deg, #e2bf86 0%, #d49a58 55%, #be7e43 100%)
    border: 5px solid #71423d
    border-radius: 3px
    color: #120702
    overflow: hidden

    &:before
      content: ''
      width: 98%
      height: 1px
      position: absolute
      top: 0.25rem
      background-color: rgba(0, 0, 0, 0.72)
      left: 1%

    &:after
      content: ''
      width: 98%
      height: 1px
      position: absolute
      bottom: 0.25rem
      background-color: rgba(0, 0, 0, 0.72)
      left: 1%

  #initModifier
    position: absolute
    left: 50%
    transform: translateX(-50%)
    transition: top 500ms ease-in
    top: 80px
    font-family: 'Architects Daughter', cursive
    font-size: 1.875rem

  .diebox
    position: absolute
    width: calc(100% - 30px)
    height: 100px
    top: 200px
    filter: drop-shadow(2px 4px 6px #000)
    display: flex
    gap: 190px
    justify-content: center

    .died12
      left: -90px
      top: -90px

    &.critical
      transform: scale3d(1.2, 1.2, 1.2)

      .face
        filter: invert(1)

    &.fail
      transform: scale3d(1.2, 1.2, 1.2)

      .face
        filter: grayscale(1)

    &.animated
      transition: all 2s

  .diecontainer
    display: none

  #diceTitle
    position: relative
    padding-top: 1.4rem
    text-align: center
    font-family: 'Architects Daughter', cursive
    font-size: 2.5rem
    color: #210e05

    .needed
      font-size: 1.875rem
      font-family: 'Architects Daughter', cursive
      position: absolute
      top: 330px
      left: 50%
      transform: translateX(-50%)

  #diceText
    position: absolute
    bottom: 10px
    width: 100%
    text-align: center
    font-family: 'Architects Daughter', cursive
    font-size: 1.25rem
    color: #180802

  .multiple-dice-container
    z-index: 107
    padding: 16px 16px 32px 16px
    text-align: center

    .multiple-dice-title
      padding-top: 1.1rem
      font-size: 2.5rem
      color: #000
      font-family: 'Architects Daughter', cursive

    .multiple-dice-modifier
      position: absolute
      left: 50%
      transform: translateX(-50%)
      transition: top 500ms ease-in
      top: 80px
      font-size: 1.875rem
      color: #000
      font-family: 'Architects Daughter', cursive

    .multiple-dice-box
      position: absolute
      width: calc(100% - 30px)
      height: 100px
      top: 200px
      filter: drop-shadow(2px 4px 6px #000)
      display: flex
      gap: 190px
      justify-content: center

    .multiple-dice-total
      position: absolute
      bottom: 12px
      width: 100%
      text-align: center
      font-family: 'Architects Daughter', cursive
      font-size: 1.25rem
      color: #000

  .multiple-die
    display: inline-block

    &.rolling
      animation: rollMultipleDice 1.5s ease-out

  .die
    width: 0
    height: 0
    transform-style: preserve-3d
    transition: transform 0.33s ease-out
    transform: rotate3d(1, 0, 0, -45deg)

    .face
      transform-origin: center

    &.reset
      transition: transform 1s ease-out
      transform: rotate3d(1, 0, 0, 0deg)

    &.died6
      &.rolling
        animation: rollD6 1s ease-out

    &.died20,
    &.died10
      &.rolling
        animation: roll 1s ease-out

    &.died4
      --tilt: 19.5deg
      --height: 135px
      --width: 77.94px
      --distance: 22.5px

      &[data-face="1"]
        transform: rotate3d(1, 0, 0, -10deg) rotate3d(0, 1, 0, -60deg) translate3d(0px, -50px, 10px)

        .face.face-2:not(.show)
          filter: brightness(0.8)

        .face.face-3:not(.show)
          filter: brightness(1.2)

      &[data-face="2"]
        transform: rotate3d(1, 0, 0, 25deg) rotate3d(0, 1, 0, -35deg) rotate3d(0, 0, 1, -90deg) translate3d(-30px, -40px, 0px)

        .face.face-1:not(.show)
          filter: brightness(0.8)

        .face.face-4:not(.show)
          filter: brightness(1.2)

      &[data-face="3"]
        transform: rotate3d(1, 0, 0, 25deg) rotate3d(0, 1, 0, 35deg) rotate3d(0, 0, 1, 90deg) translate3d(-30px, -50px, 0px)

        .face.face-4:not(.show)
          filter: brightness(0.8)

        .face.face-1:not(.show)
          filter: brightness(1.2)

      &[data-face="4"]
        transform: rotate3d(1, 0, 0, -120deg) rotate3d(0, 1, 0, 0deg) rotate3d(0, 0, 1, 0deg) translate3d(-30px, -40px, 0px)

        .face.face-1:not(.show)
          filter: brightness(0.8)

        .face.face-3:not(.show)
          filter: brightness(1.2)

      .face
        position: absolute
        left: 50%
        top: 0
        margin: 0 -50px
        border-left: 50px solid transparent
        border-right: 50px solid transparent
        border-bottom: 86px solid rgba(0, 0, 0, 0)
        width: 0
        height: 0
        transform-origin: 50% 50% 0
        transform-style: preserve-3d
        backface-visibility: hidden
        color: #fff
        font-size: 2.6875rem
        text-align: center
        line-height: 227px
        text-indent: -12px
        clip-path: polygon(50% 0, 100% 100%, 0 100%)
        background-size: 150px
        background-position: -70px -30px
        text-shadow: 2px 2px 1px #ffffff80, 2px -2px 1px #000000e0, -2px 2px 1px #000000e0, -2px -2px 1px #000000e0

        &:not(.show)
          filter: brightness(0.8)

        &.show
          filter: brightness(0.5)

        &.face-1
          border-width: 0 var(--width) var(--height) var(--width)
          transform: rotateY(0deg) rotateX(var(--tilt)) translateZ(var(--distance))

        &.face-3
          border-width: 0 var(--width) var(--height) var(--width)
          transform: rotateY(120deg) rotateX(var(--tilt)) translateZ(var(--distance))

        &.face-2
          border-width: 0 var(--width) var(--height) var(--width)
          transform: rotateY(240deg) rotateX(var(--tilt)) translateZ(var(--distance))

        &.face-4
          border-width: 0 var(--width) var(--height) var(--width)
          transform: rotateX(90deg) rotateY(180deg) rotateZ(0deg) translate3d(-3px, -21px, calc(var(--distance) * 2.55))

        &:before
          content: attr(data-before)
          position: absolute
          top: 41.5px
          left: -50px
          color: #fff
          text-shadow: 2px 2px 1px #ffffff80, 2px -2px 1px #000000e0, -2px 2px 1px #000000e0, -2px -2px 1px #000000e0
          font-size: 2.6875rem
          text-align: center
          line-height: 77.4px
          width: 100px
          height: 86.6px
          transform: rotateZ(120deg) translateY(24px)

        &:after
          content: attr(data-after)
          position: absolute
          top: 50px
          left: -50px
          color: #fff
          text-shadow: 2px 2px 1px #ffffff80, 2px -2px 1px #000000e0, -2px 2px 1px #000000e0, -2px -2px 1px #000000e0
          font-size: 2.6875rem
          text-align: center
          line-height: 77.4px
          width: 100px
          height: 86.6px
          transform: rotateZ(-120deg) translateY(30px)

      &.wood
        d4SpecialSkin('wood', 3)

    &.died6
