  12%
    transform: rotate3d(1, 0, 0, 120deg) rotate3d(0, 1, 0, 240deg) rotate3d(0, 0, 1, 0deg) translate3d(10px, -66px, 0px)
  25%
    transform: rotate3d(1, 0, 0, 240deg) rotate3d(0, 1, 0, 480deg) rotate3d(0, 0, 1, 0deg) translate3d(0px, -55px, 0px)
  38%
    transform: rotate3d(1, 0, 0, 360deg) rotate3d(0, 1, 0, 720deg) rotate3d(0, 0, 1, 0deg) translate3d(0px, -52px, 0px)
  50%
    transform: rotate3d(1, 0, 0, 480deg) rotate3d(0, 1, 0, 960deg) rotate3d(0, 0, 1, 0deg) translate3d(0px, -51px, 0px)
  62%
    transform: rotate3d(1, 0, 0, 360deg) rotate3d(0, 1, 0, 720deg) rotate3d(0, 0, 1, 0deg) translate3d(0px, -52px, 0px)
  75%
    transform: rotate3d(1, 0, 0, 240deg) rotate3d(0, 1, 0, 480deg) rotate3d(0, 0, 1, 0deg) translate3d(0px, -55px, 0px)
  88%
