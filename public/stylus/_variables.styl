// ==========================================================================
// Design Tokens - CSS Variables
// ==========================================================================

:root
  // Wood Palette
  --wood-900: #2a1409
  --wood-800: #3b2412
  --wood-700: #4c2e16
  --wood-600: #5c371a
  --wood-500: #6e4120
  --wood-400: #8b5a33
  --wood-300: #a46c40
  --wood-200: #c1865a
  --wood-100: #d7a573

  // Parchment Palette
  --parchment-900: #6a5c3b
  --parchment-800: #8a7a4e
  --parchment-700: #a99663
  --parchment-600: #c3b07a
  --parchment-500: #d7c796
  --parchment-400: #e3d5aa
  --parchment-300: #eadfbc
  --parchment-200: #f0e7cd
  --parchment-100: #f6f0dc

  // Brass and Metals
  --brass-700: #7a5a23
  --brass-800: #6e4f1f
  --brass-600: #866428
  --brass-500: #9c7c38
  --brass-400: #b08f43
  --brass-300: #caa24a
  --brass-200: #dfbc68
  --brass-100: #f0dba2

  // Accent Colors
  --green-crt: #8ef27e
  --green-crt-dim: #4ea94b
  --teal-400: #7bd4d2
  --red-500: #b33a2b
  --red-600: #8e2e22
  --red-700: #6e2118
  --success-500: #6d9f55
  --success-600: #507842
  --warning-500: #c59334
  --warning-600: #9f7120
  --danger-500: #c3533b
  --danger-600: #972f22
  --error-500: #c3533b
  --error-700: #741d16
  --info-500: #5f96a0
  --info-600: #457884
  --brown-800: var(--wood-800)
  --brown-700: var(--wood-700)
  --brown-600: var(--wood-600)

  // Ink Colors
  --ink-900: #0b0a09
  --ink-700: #1d1611
  --ink-500: #2b1c15
  --ink-300: #3a2a20

  // Text Colors
  --text-strong: #f6f0dc
  --text-soft: #efe6cd
  --text-dim: #d9ccab
  --text-ink: #20130e
  --text-light: #fbf6e7

  // Shadows and Bevels
  --bevel-light: rgba(255, 235, 180, 0.55)
  --bevel-dark: rgba(22, 9, 3, 0.6)
  --shadow-wood: 0 2px 0 var(--bevel-dark), 0 4px 10px rgba(0,0,0,0.35), inset 0 1px 0 var(--bevel-light), inset 0 -1px 0 rgba(0,0,0,0.35)
  --shadow-wood-hover: 0 4px 0 rgba(22, 9, 3, 0.75), 0 12px 24px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255, 235, 180, 0.65), inset 0 -1px 0 rgba(0,0,0,0.4)

  // Border Radii
  --radius-full: 999px
  --radius-xs: 4px
  --radius-sm: 8px
  --radius-md: 12px
  --radius-lg: 18px
  --radius-xl: 24px

  // Spacing Scale - 4px base
  --space-1: 4px
  --space-2: 8px
  --space-3: 12px
  --space-4: 16px
  --space-5: 20px
  --space-6: 24px
  --space-7: 28px
  --space-8: 32px
  --space-10: 40px
  --space-12: 48px

  // Transitions
  --t-fast: 120ms
  --t-med: 220ms
  --t-medium: 220ms
  --t-normal: 180ms
  --t-slow: 420ms
  --ease: cubic-bezier(0.2, 0.8, 0.2, 1)

  // Z-indices
  --z-dropdown: 50
  --z-overlay: 100
  --z-modal: 200
  --z-toast: 300
  --parchment-50: #fbf8ef

